{
  // Брать сроки хранения камер из конфигурации Macroscop (резервные копии в ConfigsBackups).
  // Сроки, указанные ниже в cameraRetentionDays, всё равно важнее.
  "retentionFromMacroscop": true,

  // Срок по умолчанию, если конфигурацию Macroscop прочитать не удалось, дней
  "defaultRetentionDays": 90,

  // Ручные исключения. Ключ — имя камеры как в Macroscop или её GUID. Обычно не нужны.
  "cameraRetentionDays": {
  },

  // Камера «тяжёлая», если пишет в сутки во столько раз больше медианной камеры сервера
  "heavyFactor": 2.5,

  // Пусто = искать X:\MacroscopArchive на всех дисках
  "archiveRoots": [],

  // null = C:\ProgramData\Macroscop\Logs_Macroscop
  "logsDir": null,

  // Сколько дисков сканировать параллельно
  "scanThreads": 4
}
